# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
# SQLAlchemy URL. Defaults to a SQLite file in the backend directory.
# PostgreSQL URLs from Render/Heroku (postgres://...) are accepted as-is.
DATABASE_URL=sqlite:///./fakeguard.db

# ---------------------------------------------------------------------------
# CORS
# ---------------------------------------------------------------------------
# Comma-separated list of origins allowed to call the API (no trailing slash).
CORS_ORIGINS=http://localhost:5173

# Maximum accepted CSV upload size in bytes (default 5 MB).
MAX_UPLOAD_BYTES=5242880

# ---------------------------------------------------------------------------
# Authentication
# ---------------------------------------------------------------------------
# Protected endpoints return 503 until authentication is configured, unless it
# is explicitly disabled. AUTH_DISABLED=true is convenient for local demos;
# never set it on a server reachable by others.
AUTH_DISABLED=true

# Reviewer account. Generate the hash (prompts for the password, min 12 chars):
#   python -m app.security hash-password
# Generate the signing key:
#   python -m app.security generate-secret
# AUTH_USERNAME=reviewer
# AUTH_PASSWORD_HASH=scrypt$32768$8$1$...
# AUTH_SECRET_KEY=
# Session lifetime in minutes (default 480 = 8 hours).
# AUTH_TOKEN_TTL_MINUTES=480

# ---------------------------------------------------------------------------
# Rate limiting (requests per minute per client IP; 0 disables one limit)
# ---------------------------------------------------------------------------
# RATE_LIMIT_ENABLED=true
# RATE_LIMIT_LOGIN_PER_MINUTE=5
# RATE_LIMIT_API_PER_MINUTE=120
# RATE_LIMIT_IMPORT_PER_MINUTE=10
# Number of reverse proxies in front of the app that append to
# X-Forwarded-For. Keep 0 unless you have verified the proxy chain.
# TRUSTED_PROXY_HOPS=0
